# .env.example - Platform Environment Configuration
PORT=5000
NODE_ENV=production
JWT_SECRET=impof_production_jwt_secret_key_change_me

# Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=impof_platform
POSTGRES_USER=impof_user
POSTGRES_PASSWORD=impof_secure_password

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Analysis Engine Configuration
ANALYSIS_ENGINE_URL=http://analysis-engine:8000
PROMETHEUS_URL=http://prometheus:9090
